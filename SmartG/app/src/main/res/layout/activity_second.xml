<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teal_700"
    tools:context=".SecondActivity">

    <View
        android:id="@+id/black_outline_act2"
        android:layout_width="417dp"
        android:layout_height="688dp"
        android:layout_marginStart="13dp"
        android:layout_marginTop="17dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="16dp"
        android:background="@color/black"
        android:backgroundTint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.482"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.428" />

    <Button
        android:id="@+id/ble_page"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/teal_700"
        android:text="BLE"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.213"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.951" />

    <Button
        android:id="@+id/unpairButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#111111"
        android:fontFamily="sans-serif"
        android:text="stop pair"
        android:textColor="#999595"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/connectedDevice"
        app:layout_constraintStart_toEndOf="@+id/connectedDeviceLabel" />

    <Button
        android:id="@+id/translator_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:text="translator"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.777"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.951" />


<!--    bluetooth scan and connect elements-->
<!--    android:background="#481E1D1D"-->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/bluetooth_switch"
        android:layout_width="320dp"
        android:layout_height="70dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="156dp"
        android:background="@drawable/round_box_black"
        android:backgroundTint="#481E1D1D"
        android:backgroundTintMode="add"
        android:checked="false"
        android:clipToOutline="false"
        android:padding="12dp"
        android:text="Bluetooth"
        android:textColor="@color/white"
        android:textColorLink="#090808"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:useMaterialThemeColors="false" />


    <TextView
        android:id="@+id/devicesLabel"
        android:layout_width="88dp"
        android:layout_height="27dp"
        android:layout_marginTop="60dp"
        android:paddingStart="12dp"
        android:text="Devices"
        android:textColor="#999595"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bluetooth_switch" />

    <TextView
        android:id="@+id/connectedDeviceLabel"
        android:layout_width="173dp"
        android:layout_height="28dp"
        android:layout_marginTop="52dp"
        android:paddingStart="12dp"
        android:text="Connected Device"
        android:textColor="#999595"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.214"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listDevices" />

<!--    android:background="@color/white"-->
    <ListView
        android:id="@+id/listDevices"
        android:layout_width="327dp"
        android:layout_height="194dp"
        android:layout_marginStart="52dp"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="160dp"
        android:background="@drawable/round_box_black"
        android:backgroundTint="#481E1D1D"
        android:cacheColorHint="@color/white"
        android:outlineAmbientShadowColor="#D7CDCD"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/devicesLabel"
        app:layout_constraintVertical_bias="0.082" />

<!--    android:background="#481E1D1D"-->
    <TextView
        android:id="@+id/connectedDevice"
        android:layout_width="327dp"
        android:layout_height="37dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/round_box_black"
        android:backgroundTint="#481E1D1D"
        android:backgroundTintMode="add"
        android:paddingStart="12dp"
        android:text="no device"
        android:textColor="#009688"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.604"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/connectedDeviceLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>